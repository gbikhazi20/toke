#!/usr/bin/env python3
"""Count input tokens using Anthropic or OpenAI's counting API."""

import argparse
import http.client
import json
import math
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request


PROVIDERS = {
    "anthropic": {
        "model": "claude-opus-4-8",
        "key": "ANTHROPIC_API_KEY",
        "url": "https://api.anthropic.com/v1/messages/count_tokens",
        "models_url": "https://api.anthropic.com/v1/models",
    },
    "openai": {
        "model": "gpt-5.4",
        "key": "OPENAI_API_KEY",
        "url": "https://api.openai.com/v1/responses/input_tokens",
        "models_url": "https://api.openai.com/v1/models",
    },
}
LIST_MODELS = object()


class CountError(Exception):
    """An actionable error to display without a traceback."""


def positive_seconds(value):
    seconds = float(value)
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("timeout must be a positive, finite number")
    return seconds


def parser():
    cli = argparse.ArgumentParser(
        description="Count text input tokens with a provider API (includes message overhead).",
        epilog=(
            "Defaults: anthropic / claude-opus-4-8; openai / gpt-5.4. "
            "Override defaults with TOKE_PROVIDER and "
            "TOKE_ANTHROPIC_MODEL or TOKE_OPENAI_MODEL. "
            "Authentication: ANTHROPIC_API_KEY or OPENAI_API_KEY."
        ),
        allow_abbrev=False,
    )
    sources = cli.add_mutually_exclusive_group()
    sources.add_argument("text", nargs="?", help="inline text (quote strings containing spaces)")
    sources.add_argument("-t", "--text", dest="inline_text", help="inline text")
    sources.add_argument("-f", "--file", help="UTF-8 text file, or - for stdin")
    sources.add_argument("--list-models", action="store_true", help="list model IDs available from the selected provider")
    sources.add_argument("--list-providers", action="store_true", help="list supported providers and built-in default models (no API key needed)")
    cli.add_argument("-p", "--provider", choices=PROVIDERS, help="provider (default: anthropic)")
    cli.add_argument("-m", "--model", nargs="?", const=LIST_MODELS,
                     help="select a model ID; omit the value to list models for the provider")
    output = cli.add_mutually_exclusive_group()
    output.add_argument("--json", action="store_true", help="output the token count, models, or providers as JSON")
    output.add_argument("-q", "--quiet", action="store_true", help="output only the token count or provider IDs (model lists already contain only IDs)")
    cli.add_argument("--timeout", type=positive_seconds, default=30, help="request timeout in seconds (default: 30)")
    return cli


def read_text(args, stdin):
    if args.text is not None:
        return args.text
    if args.inline_text is not None:
        return args.inline_text
    if args.file is not None and args.file != "-":
        # Decode bytes directly to preserve CRLF and all other whitespace.
        return Path(args.file).read_bytes().decode("utf-8")
    if stdin.isatty() and args.file != "-":
        raise CountError("provide inline text, --file PATH, or pipe text to stdin (see --help)")
    if hasattr(stdin, "buffer"):
        return stdin.buffer.read().decode("utf-8")
    return stdin.read()


def request_json(provider, url, api_key, timeout, body=None):
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if provider == "anthropic":
        headers.update({"x-api-key": api_key, "anthropic-version": "2023-06-01"})
    else:
        headers["Authorization"] = "Bearer " + api_key

    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8") if body is not None else None,
        headers=headers,
        method="POST" if body is not None else "GET",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        with exc:
            raw_error = exc.read()
        message = str(exc.reason)
        try:
            detail = json.loads(raw_error)
            if isinstance(detail, dict) and isinstance(detail.get("error"), dict):
                message = str(detail["error"].get("message") or message)
        except (ValueError, UnicodeError):
            pass
        # Providers sometimes repeat a rejected key in authentication errors.
        message = message.replace(api_key, "[redacted]")
        message = " ".join(message.split())[:1000]
        raise CountError(f"{provider} API returned HTTP {exc.code}: {message}") from exc
    except (urllib.error.URLError, OSError, http.client.HTTPException) as exc:
        raise CountError(f"{provider} request failed: {exc}") from exc

    try:
        return json.loads(raw)
    except (ValueError, UnicodeError) as exc:
        raise CountError(f"{provider} API returned invalid JSON") from exc


def count_tokens(text, provider, model, api_key, timeout):
    if provider == "anthropic":
        body = {"model": model, "messages": [{"role": "user", "content": text}]}
    else:
        body = {"model": model, "input": text}
    result = request_json(provider, PROVIDERS[provider]["url"], api_key, timeout, body)
    count = result.get("input_tokens") if isinstance(result, dict) else None
    if type(count) is not int or count < 0:
        raise CountError(f"{provider} API response is missing a valid input_tokens count")
    return count


def list_models(provider, api_key, timeout):
    base_url = PROVIDERS[provider]["models_url"]
    url = base_url
    model_ids = set()
    cursors = set()
    while True:
        result = request_json(provider, url, api_key, timeout)
        data = result.get("data") if isinstance(result, dict) else None
        if not isinstance(data, list):
            raise CountError(f"{provider} API response is missing a valid model list")
        for model in data:
            model_id = model.get("id") if isinstance(model, dict) else None
            if not isinstance(model_id, str) or not model_id.strip():
                raise CountError(f"{provider} API response contains an invalid model ID")
            model_ids.add(model_id)
        if provider != "anthropic":
            break
        has_more = result.get("has_more", False)
        if type(has_more) is not bool:
            raise CountError("anthropic API returned invalid model pagination")
        if not has_more:
            break
        cursor = result.get("last_id")
        if not isinstance(cursor, str) or not cursor or cursor in cursors:
            raise CountError("anthropic API returned invalid or repeated model pagination cursor")
        cursors.add(cursor)
        url = base_url + "?" + urllib.parse.urlencode({"after_id": cursor})
    return sorted(model_ids)


def main(argv=None):
    cli = parser()
    args = cli.parse_args(argv)
    if args.model is LIST_MODELS:
        if args.list_providers or any(value is not None for value in (args.text, args.inline_text, args.file)):
            cli.error("-m without a model lists models and cannot be combined with input or --list-providers")
        args.list_models = True
        args.model = None
    if args.list_providers:
        if args.provider is not None or args.model is not None:
            cli.error("--provider and --model cannot be combined with --list-providers")
        providers = [{"id": name, "default_model": config["model"]}
                     for name, config in PROVIDERS.items()]
        if args.json:
            print(json.dumps({"providers": providers}))
        elif args.quiet:
            for provider in providers:
                print(provider["id"])
        else:
            print(f"{'Provider':<12}Default model")
            for provider in providers:
                print(f"{provider['id']:<12}{provider['default_model']}")
        return 0
    provider = args.provider or os.environ.get("TOKE_PROVIDER", "anthropic")
    if provider not in PROVIDERS:
        cli.error("TOKE_PROVIDER must be anthropic or openai")
    model = args.model if args.model is not None else os.environ.get(
        f"TOKE_{provider.upper()}_MODEL", PROVIDERS[provider]["model"]
    )
    if args.list_models and args.model is not None:
        cli.error("--model cannot be combined with --list-models")
    if not args.list_models and not model.strip():
        cli.error("model must not be empty")
    try:
        text = None if args.list_models else read_text(args, sys.stdin)
        key_name = PROVIDERS[provider]["key"]
        api_key = os.environ.get(key_name, "").strip()
        if not api_key:
            raise CountError(f"set {key_name} to use {provider}")
        if args.list_models:
            models = list_models(provider, api_key, args.timeout)
            if args.json:
                print(json.dumps({"provider": provider, "models": models}))
            else:
                for model_id in models:
                    print(model_id)
            return 0
        count = count_tokens(text, provider, model, api_key, args.timeout)
        if args.json:
            print(json.dumps({"provider": provider, "model": model, "input_tokens": count}))
        elif args.quiet:
            print(count)
        else:
            print(f"Input tokens: {count:,}")
            print(f"Provider:     {provider}")
            print(f"Model:        {model}")
        return 0
    except (CountError, OSError, UnicodeError) as exc:
        print(f"toke: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("toke: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
